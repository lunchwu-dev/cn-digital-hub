# ── 依赖 ─────────────────────────────────────────────
node_modules/
package-lock.json.bak

# ── 构建产物 ──────────────────────────────────────────
# 保留：portal/dist/ —— 这是可直接双击运行的交付原型，纳入版本管理
.vite/
*.tsbuildinfo

# ── 验证过程中的临时产物 ──────────────────────────────
# 保留：outputs/_research/*.mjs、outputs/_verify/*.mjs —— 复验脚本
# 忽略：脚本运行时产生的一次性输出、中间解压目录、导出暂存区
outputs/_export/
outputs/_probe.txt
outputs/_research/*.txt
outputs/_research/*.raw
outputs/_research/*.log
outputs/_research/*.bak
outputs/_research/zip-*/
outputs/_research/shots-backup/
outputs/_research/shots-*.txt
outputs/_verify/*.json
outputs/_verify/*.log
outputs/_verify/*.err.txt

# ── 站点部署副本（与 portal/dist/ 逐字节一致的冗余拷贝）──
outputs/deploy-site/

# ── 公网发布用的静态站点副本（与 portal/dist/ 逐字节一致，不重复纳入）──
portal-site/

# ── 根目录临时文件（探针 / 诊断输出）────────────────────
# 约定：根目录下 `_` 开头的 .txt / .log / .png / .js / .json / .cjs 属一次性产物。
# 例外（显式放行，见下方 negation）：`_release_v*.md` —— 各版本发布说明，有长期价值。
/_*.txt
/_*.log
/_*.png
/_*.js
/_*.json
/_*.cjs
!/_release_v*.md
/_probe_site/
/_cprof/

# ── CDP / headless Chrome 用户数据目录（体积大、纯缓存）──
# 注意：目录名含下划线（如 portal/_cdp_scope_profile/），不会被上方的 `/_*.txt` 一类规则命中，
#      已由下方 `/portal/_*` 与 `/portal/_cdp_profile*` 覆盖，此处再显式声明一次以防遗漏。
/portal/_cdp_*/

# ── 运行时与本地环境 ──────────────────────────────────
*.log
logs/
.env
.env.local
.DS_Store
Thumbs.db
Desktop.ini

# ── 编辑器 / IDE ──────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# ── 平台内部数据与标记文件 ────────────────────────────
.workbuddy/
.wbapp_*.genie
.wbapp_*

# ── 变异自证运行期产物（tests/mutation.cjs / mutation.sh）──
# 备份目录与并发锁只在运行时存在，跑完会自清；忽略以防中断残留
portal/tests/.mutation-backup/
portal/tests/.mutation.lock
# v0.5.1：变异编排改为 Bash 驱动器后，_mut_snapshot.cjs 会把 8 个目标源文件
#   快照到 tests/.mutbase/ 供 apply→restore 往返使用。它是**运行期副本**（含 src 全文），
#   不是源码，必须忽略。
portal/tests/.mutbase/
# 同上：apply/restore 的沙盒往返验证用临时目录
portal/tests/.tmp_mutcheck/

# ── portal 下的验证脚本与运行期输出 ────────────────────
# 约定：portal/ 根目录（不含 src/ tests/）中 **下划线或纯小写单字母开头** 的
# .cjs / .mjs / .js / .txt / .json 一律视为一次性验证产物，不入库。
# 说明：这些文件是 CDP 复验、变异测试、交付组装时的中间脚本与日志，
#      有价值的结论已沉淀进 tests/ 与 outputs/，原件留着只会淹没真实代码。
/portal/_*.cjs
/portal/_*.mjs
/portal/_*.js
/portal/_*.txt
/portal/_*.json
/portal/[a-z].txt
/portal/smoke*.txt
/portal/dist-check*.txt
/portal/build-*.txt

# src 下的临时状态快照（验证时导出，非源码）
/portal/src/_*.txt

# tests 下的一次性探针（正式套件是 smoke.cjs / shots.cjs / mutation.cjs / mutation.sh）
/portal/tests/_*.cjs
/portal/tests/_*.mjs
/portal/tests/_*.txt

# ★ 例外：上面那条 `/portal/tests/_*.cjs` 会连带忽略**变异套件的加载路径** ——
#   `tests/mutation.cjs`（已入库）会 require `_mutations.data.cjs`，`mutation.sh`
#   会调用 `_mut_*.cjs` 与 `_geom_gantt*.cjs`。它们不是一次性探针，而是套件的组成部分：
#   若不入库，clone 下来的仓库里 mutation.cjs 直接 MODULE_NOT_FOUND、
#   mutation.sh 少叶子脚本跑不起来 —— 等于把变异自证整体弄坏。
#   故逐个显式反忽略（git 的 `!` 对**文件**模式有效；父目录未被整体排除，故可用）。
!/portal/tests/_mutations.data.cjs
!/portal/tests/_mut_apply.cjs
!/portal/tests/_mut_restore.cjs
!/portal/tests/_mut_snapshot.cjs
!/portal/tests/_geom_gantt.cjs
!/portal/tests/_geom_gantt_nospawn.cjs

# ── CDP 调试用 Chrome 用户目录（体积大、纯缓存）──────────
/portal/_cdp_profile*/
/portal/_shots*/

# ── 交付组装与截图的工作区（截图成品在 outputs/delivery-*/ 内）──
/portal/shots_next/

# 交付说明的草稿副本 —— 正式版在 outputs/delivery-*/交付说明.md
/portal/_delivnote.md

# ── outputs 下的一次性验证脚本与日志 ─────────────────────
# 保留：*.md 设计规范/审查报告（有长期价值）、delivery-*/ 交付包
# 忽略：脚本与运行日志
outputs/_*.cjs
outputs/_*.mjs
outputs/_*.js
outputs/_*.txt
outputs/_*.json
